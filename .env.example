# Copy to .env only if you need to override defaults. The project runs with no secrets.
# start.sh loads this file automatically; exported variables work too.

# Backend bind address for start.sh / start.bat
API_HOST=127.0.0.1
API_PORT=8000

# Optional: IBM Granite embedding model override
# GRANITE_MODEL=ibm-granite/granite-embedding-30m-english

# Optional: Hugging Face cache location (large downloads)
# HF_HOME=./.hf-cache

# Optional: generative IBM Granite through watsonx.ai.
# Without these the assistant uses the local Granite embedding index and
# deterministic grounded retrieval, which needs no account or API key.
# Create a watsonx.ai project, then copy its project id and an API key.
# WATSONX_API_KEY=
# WATSONX_PROJECT_ID=
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_MODEL_ID=ibm/granite-3-3-8b-instruct
# WATSONX_API_VERSION=2025-02-11
# Alternative to an API key, if you already have an IAM bearer token:
# WATSONX_BEARER_TOKEN=

# Optional: local generative Granite through llama.cpp.
# start.sh starts this automatically when local_ai/ exists; no account is needed.
# Download it once with: python setup_local_ai.py
# LOCAL_GRANITE_PORT=8081
# LOCAL_GRANITE_URL=http://127.0.0.1:8081
# LOCAL_GRANITE_MODEL=granite-3.3-2b-instruct-Q3_K_M
# Set this to keep tests or the API in grounded-only mode:
# LOCAL_GRANITE_DISABLED=1
