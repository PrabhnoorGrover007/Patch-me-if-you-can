# -----------------------------------------------------------------------------
# AI provider
#
# Gemini is used whenever GEMINI_API_KEY is set. Get a key at
# https://aistudio.google.com/apikey (free tier is enough for a demo).
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.6-flash
# Optional: override the REST base (proxy, gateway, or a pinned API version).
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta

# -----------------------------------------------------------------------------
# IBM watsonx / Granite (optional)
#
# Only used when GEMINI_API_KEY is empty, so the IBM track stays runnable for
# anyone with watsonx credits. Both values are required for this path.
# -----------------------------------------------------------------------------
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
GRANITE_MODEL_ID=ibm/granite-4-h-small

# -----------------------------------------------------------------------------
# Storage
#
# The remediation board is a JSON file on the server. Point this at a writable
# absolute path when the project runs on a read-only filesystem (e.g. Vercel).
# -----------------------------------------------------------------------------
# REMEDIATION_STORE=
